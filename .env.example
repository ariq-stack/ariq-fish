# Environment Variables Template
# Salin file ini menjadi .env.local dan isi dengan konfigurasi Anda

# Google Apps Script Web App (Step 2)
APPS_SCRIPT_URL=https://script.google.com/macros/s/AKfycbx_contoh_deployment_id/exec
APPS_SCRIPT_SECRET=ganti_dengan_token_rahasia_bersama_apps_script

# Session & JWT Secret (Step 2)
JWT_SECRET=buat_kunci_rahasia_acak_minimal_32_karakter_di_sini

# Base URL (opsional untuk production di Vercel)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

